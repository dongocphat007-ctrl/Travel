# Sao chép thành .env rồi điền. KHÔNG commit .env, KHÔNG đưa key vào JS chạy ở trình duyệt.
PORT=8080
# Địa chỉ công khai (không có dấu / cuối) cho sitemap, og:url, canonical
SITE_URL=http://localhost:8080

# ── Tài khoản quản trị ──
# Admin mặc định chỉ được tạo khi có CẢ HAI biến (mật khẩu ≥ 8 ký tự). Để trống = không tạo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Client ID của Google Sign-In (công khai, phải trùng GOOGLE_CLIENT_ID trong js/main.js)
GOOGLE_CLIENT_ID=
# Khóa ký cookie phiên. Để trống = tự sinh một lần và lưu ở storage/db/.secret
SESSION_SECRET=

# ── AI (khóa nằm ở server, KHÔNG nằm trong js/) ── lấy tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Langfuse (LLM Observability & Tracing) ── https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Email (OTP đăng ký + xác nhận booking) — API dạng Resend (https://resend.com) ──
EMAIL_API_KEY=
EMAIL_FROM=
# Chỉ dùng khi phát triển, chưa có email: in mã OTP ra log máy chủ
OTP_DEV_LOG=true
# ── Thanh toán chuyển khoản (SePay/Casso/PayOS → webhook) ──
# Tài khoản nhận tiền hiển thị cho khách
PAYMENT_BANK=Vietcombank
PAYMENT_ACCOUNT=
PAYMENT_ACCOUNT_NAME=
# Tiền tố mã chuyển khoản (chỉ chữ+số, PHẢI khớp cấu hình "nhận diện mã thanh toán" bên dịch vụ)
PAYMENT_PREFIX=TRAVEL
# Chuỗi bí mật; dịch vụ ngân hàng gửi header "Authorization: Apikey <chuỗi này>". Trống = webhook bị từ chối.
PAYMENT_WEBHOOK_SECRET=

# Đặt true khi chạy sau reverse proxy (Nginx/Cloudflare) để rate limit theo IP thật
TRUST_PROXY=false

# Google Maps JavaScript API (bản đồ tiếng Việt). Khóa này lộ ra trình duyệt: hãy giới hạn theo HTTP referrer
# và chỉ bật "Maps JavaScript API". Để trống = dùng nền OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# ── Chuyến bay & khách sạn TRỰC TUYẾN — chỉ cần dán 3 khóa dưới đây, còn lại đã đặt sẵn mặc định ──
# Chuyến bay (Ignav): https://ignav.com/signup → Dashboard → API key. ~2 USD / 1.000 lượt gọi. Trống = dùng danh mục có sẵn.
IGNAV_API_KEY=
# Khách sạn — danh sách, ảnh, đánh giá (Google Places API (New)): bật "Places API (New)" trong Google Cloud, KHÔNG dùng chung khóa Maps JS ở trên,
# nên đặt hạn chế theo API (chỉ Places API (New)) và theo IP máy chủ.
GOOGLE_PLACES_API_KEY=
# Khách sạn — giá & liên kết đặt (Travelpayouts / Hotellook, có Agoda): Travelpayouts → Tools → API → token; marker = mã affiliate của bạn.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# (tuỳ chọn, đã có mặc định) IGNAV_MARKET=VN  HOTEL_CURRENCY=vnd  LIVE_CACHE_SECONDS=600  HOTEL_LINK_TEMPLATE=  TRAVELPAYOUTS_BASE_URL=
